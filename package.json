{
  "name": "haai",
  "version": "1.0.0",
  "description": "Home Assistant AI Assistant Windows Desktop App",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json && vite build",
    "dist": "npm run build:electron && electron-builder"
  },
  "keywords": ["home-assistant", "ai", "electron", "smart-home", "ollama", "claude", "openai", "gemini"],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "home-assistant-js-websocket": "^9.4.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "wait-on": "^8.0.2"
  }
}
